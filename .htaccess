AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Alle Varianten (http, www) per 301 auf https://easytechit.de
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://easytechit.de%{REQUEST_URI} [L,R=301]

  # Projekt-Detailrouten existieren nur in der App, Direktaufrufe auf die Übersicht
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^projekte/[^/]+/?$ /projekte/ [L,R=301]
</IfModule>
